---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.json';
const waUrl = `https://wa.me/${site.whatsapp_number}`;
---
<Layout title="Contacto" description="Contactanos por WhatsApp o Instagram. Hacemos envíos a todo Paraguay.">
  <section class="hero" style="padding:2.5rem 0 2rem">
    <div class="container">
      <div class="eyebrow">Hablemos</div>
      <h1>Contacto</h1>
      <p>Pedinos por WhatsApp o seguinos en Instagram para ver las novedades</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:760px">
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(260px,1fr));gap:1.2rem">
        <a href={waUrl} target="_blank" rel="noopener" style="background:var(--color-surface);padding:1.6rem;border-radius:var(--radius-lg);border:1px solid var(--color-border);text-align:center;text-decoration:none;color:var(--color-primary)">
          <div style="font-size:2.6rem">📱</div>
          <h3 style="margin:0.4rem 0">WhatsApp</h3>
          <p style="margin:0.2rem 0;font-weight:700">{site.whatsapp_display}</p>
          <p style="margin:0.3rem 0 0;color:var(--color-text-muted);font-size:0.85rem">Respuesta rápida · Hacemos tu pedido</p>
        </a>
        <a href={site.instagram_url} target="_blank" rel="noopener" style="background:var(--color-surface);padding:1.6rem;border-radius:var(--radius-lg);border:1px solid var(--color-border);text-align:center;text-decoration:none;color:var(--color-primary)">
          <div style="font-size:2.6rem">📷</div>
          <h3 style="margin:0.4rem 0">Instagram</h3>
          <p style="margin:0.2rem 0;font-weight:700">@{site.instagram_handle}</p>
          <p style="margin:0.3rem 0 0;color:var(--color-text-muted);font-size:0.85rem">Novedades, fotos, behind the scenes</p>
        </a>
      </div>

      <div style="background:var(--color-surface);padding:1.6rem;border-radius:var(--radius-lg);border:1px solid var(--color-border);margin-top:2rem">
        <h3>Envíos</h3>
        <p>🚚 {site.shipping}. El costo de envío se acuerda por WhatsApp según tu zona.</p>
        <h3 style="margin-top:1.4rem">Medios de pago</h3>
        <p>A coordinar por WhatsApp (transferencia, giro, efectivo contra entrega según zona).</p>
        <h3 style="margin-top:1.4rem">Horarios de atención</h3>
        <p>Lunes a sábado · 9:00 a 20:00</p>
      </div>

      <div style="text-align:center;margin-top:2rem">
        <a class="btn btn-wa" href={waUrl} target="_blank" rel="noopener">📱 Abrir WhatsApp ahora</a>
      </div>
    </div>
  </section>
</Layout>
