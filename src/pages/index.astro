---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import catalog from '../../data/catalog-public.json';
import { productCountForCategory } from '../lib/catalog';

const featured = catalog.products.filter((p) => p.featured).slice(0, 8);
const waUrl = `https://wa.me/595985526379`;
const catalogUrl = '/mburucuya-potypy/catalogo';

// Use the first featured product's image as hero photo
const heroPhoto = featured[0]?.image?.startsWith('data:') ? null : (featured[0]?.image || null);
---
<Layout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <div class="eyebrow">— Asunción, Paraguay · desde 2018 —</div>
        <h1>Perfume es <em>memoria</em><br>que se puede llevar.</h1>
        <p>Una curaduría honesta de fragancias originales e inspiradas, de las casas internacionales a las que vale la pena conocer. Envíos a todo el Paraguay.</p>
        <div class="cta-row">
          <a class="cta-primary" href={catalogUrl}>Ver catálogo</a>
          <a class="cta-ghost" href={waUrl} target="_blank" rel="noopener">Pedir por WhatsApp</a>
        </div>
      </div>
      <div class="image-col">
        {heroPhoto && <div class="main"><img src={heroPhoto} alt="" /></div>}
        <div class="badge">
          <div class="num">{catalog.products.length}</div>
          <div class="label">fragancias en stock</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <div class="eyebrow">Familias olfativas</div>
        <h2>Por estado de ánimo</h2>
        <p>Ocho categorías curadas para encontrar tu próxima fragancia.</p>
      </div>
      <div class="category-grid">
        {catalog.categories.map((cat) => (
          <a class="category-card" href={`/mburucuya-potypy/categoria/${cat.slug}`}>
            <div class="photo"><img src={cat.image} alt={cat.name} loading="lazy" /></div>
            <div class="name">{cat.name}</div>
            <div class="count">{productCountForCategory(catalog, cat.slug)} productos</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title header-row">
        <div class="left">
          <div class="eyebrow">Selección</div>
          <h2>Nuestra pequeña boutique</h2>
          <p>Las fragancias que nos tienen locos esta temporada.</p>
        </div>
        <a href={catalogUrl} class="view-all">Ver todas →</a>
      </div>
      <div class="featured-row">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-title">
        <div class="eyebrow">Simple</div>
        <h2>Cómo comprar</h2>
        <p>Tres pasos, sin vueltas.</p>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));gap:3rem;text-align:center">
        <div>
          <div style="font-family:var(--font-serif);font-size:3rem;color:var(--gold);line-height:1;margin-bottom:0.8rem">I</div>
          <h3 style="font-family:var(--font-serif);font-size:1.2rem;margin-bottom:0.6rem">Elegí</h3>
          <p style="margin:0;color:var(--ink-soft);font-size:0.92rem">Recorré el catálogo y agregá tus fragancias al pedido.</p>
        </div>
        <div>
          <div style="font-family:var(--font-serif);font-size:3rem;color:var(--gold);line-height:1;margin-bottom:0.8rem">II</div>
          <h3 style="font-family:var(--font-serif);font-size:1.2rem;margin-bottom:0.6rem">Enviá</h3>
          <p style="margin:0;color:var(--ink-soft);font-size:0.92rem">Mandanos el pedido por WhatsApp con un solo click.</p>
        </div>
        <div>
          <div style="font-family:var(--font-serif);font-size:3rem;color:var(--gold);line-height:1;margin-bottom:0.8rem">III</div>
          <h3 style="font-family:var(--font-serif);font-size:1.2rem;margin-bottom:0.6rem">Recibí</h3>
          <p style="margin:0;color:var(--ink-soft);font-size:0.92rem">Te lo enviamos a cualquier punto del Paraguay.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
